  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-ZZXCKWE96S');
</script>

<style is:global>
  :root {
    --paper: #F0EAE0;
    --paper-warm: #E6DECE;
    --ink: #13100B;
    --ink-soft: #473F33;
    --ink-quiet: #857A6D;
    --accent: #C8401F;
    --accent-deep: #9E3218;
    --accent-glow: rgba(200,64,31,0.12);
    --green: #2C5F3A;
    --rule: #C2B89F;
    --available: #3A7D4C;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  /* Defensive: keep the `hidden` HTML attribute working even when class
     rules below set explicit `display` values. */
  [hidden] { display: none !important; }

  body {
    background: var(--paper);
    color: var(--ink);
    font-family: 'Geist', -apple-system, sans-serif;
    font-weight: 400;
    line-height: 1.5;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  /* Paper grain overlay */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 10;
    opacity: 0.28;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/%3E%3CfeColorMatrix values='0 0 0 0 0.07 0 0 0 0 0.06 0 0 0 0 0.04 0 0 0 0.45 0'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    mix-blend-mode: multiply;
    z-index:-1;
  }

  .container {
    max-width: 1340px;
    margin: 0 auto;
    padding: 0 clamp(1.5rem, 4vw, 3rem);
  }

  /* ─────────── GHOST TEXT ─────────── */
  .ghost-text {
    position: absolute;
    font-family: 'Fraunces', serif;
    font-weight: 700;
    font-style: italic;
    line-height: 1;
    letter-spacing: -0.05em;
    color: var(--ink);
    opacity: 0.07;
    pointer-events: none;
    user-select: none;
    white-space: nowrap;
    font-variation-settings: "opsz" 144, "SOFT" 0;
  }
  .hero { position: relative; }
  .hero .ghost-text {
    font-size: clamp(10rem, 22vw, 22rem);
    bottom: -0.1em;
    right: -0.05em;
    opacity: 0.06;
  }
  .work { position: relative; }
  .work .ghost-text {
    font-size: clamp(8rem, 18vw, 18rem);
    top: 2rem;
    right: -0.05em;
    opacity: 0.055;
  }
  .what { position: relative; }
  .what .ghost-text {
    font-size: clamp(8rem, 16vw, 16rem);
    bottom: -0.15em;
    left: -0.05em;
    opacity: 0.065;
  }
  .clients { position: relative; }
  .clients .ghost-text {
    font-size: clamp(8rem, 16vw, 16rem);
    top: 1rem;
    right: -0.05em;
    opacity: 0.055;
  }

  /* ─────────── SCROLL REVEAL ─────────── */
  .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s ease-out, transform 0.7s ease-out;
  }
  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ─────────── NAV ─────────── */
  nav.top {
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--rule);
    position: sticky;
    top: 0;
    background: rgba(240, 234, 224, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    z-index: 50;
  }
  nav.top .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
  }
  .nav-left {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .wordmark {
    font-family: 'Fraunces', serif;
    font-weight: 600;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
    font-variation-settings: "SOFT" 50;
    text-decoration: none;
    color: var(--ink);
  }
  .wordmark .dot { color: var(--accent); }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--available);
    background: rgba(58,125,76,0.1);
    border: 1px solid rgba(58,125,76,0.25);
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    white-space: nowrap;
  }
  .status-dot {
    width: 6px;
    height: 6px;
    background: var(--available);
    border-radius: 50%;
    animation: pulse-dot 2.5s ease-in-out infinite;
    flex-shrink: 0;
  }
  @keyframes pulse-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.7); }
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 2.5rem;
  }
  nav.top ul {
    display: flex;
    gap: 2rem;
    list-style: none;
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.01em;
  }
  nav.top a {
    color: var(--ink);
    text-decoration: none;
    position: relative;
    transition: color 0.2s;
  }
  nav.top a:hover { color: var(--accent); }
  nav.top ul a::after {
    content: '';
    position: absolute;
    bottom: -3px;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--accent);
    transition: width 0.3s ease;
  }
  nav.top ul a:hover::after { width: 100%; }

  .nav-socials {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .nav-socials a {
    color: var(--ink-quiet);
    transition: color 0.2s;
    display: flex;
    align-items: center;
  }
  .nav-socials a:hover { color: var(--ink); }
  .nav-socials svg { width: 16px; height: 16px; }

  /* ─────────── HERO ─────────── */
  .hero {
    padding: clamp(4.5rem, 13vh, 10rem) 0 clamp(3rem, 8vh, 6rem);
    position: relative;
    overflow: hidden;
  }
  .hero-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.13em;
    color: var(--ink-quiet);
    margin-bottom: 2.75rem;
    opacity: 0;
    animation: fadeUp 0.8s 0.1s ease-out forwards;
  }
  .hero-meta .dash {
    width: 28px;
    height: 1px;
    background: var(--rule);
  }
  .hero h1 {
    font-family: 'Fraunces', serif;
    font-weight: 400;
    font-size: clamp(3.25rem, 9.5vw, 9rem);
    line-height: 0.93;
    letter-spacing: -0.038em;
    font-variation-settings: "opsz" 144, "SOFT" 25;
    max-width: 14ch;
    margin-bottom: 3.5rem;
  }
  .hero h1 .word {
    display: inline-block;
    opacity: 0;
    transform: translateY(40px);
    animation: heroReveal 0.9s ease-out forwards;
  }
  .hero h1 .word:nth-child(1) { animation-delay: 0.15s; }
  .hero h1 .word:nth-child(2) { animation-delay: 0.25s; }
  .hero h1 .word:nth-child(3) { animation-delay: 0.35s; font-style: italic; font-weight: 300; }
  .hero h1 .word:nth-child(4) { animation-delay: 0.45s; }
  .hero h1 .word:nth-child(5) { animation-delay: 0.55s; }
  .hero h1 .word:nth-child(6) { animation-delay: 0.65s; }
  .hero h1 .word:nth-child(7) { animation-delay: 0.75s; }
  .hero h1 .word:nth-child(8) { animation-delay: 0.85s; }

  .star {
    color: var(--accent);
    display: inline-block;
    font-style: normal;
    animation: spin 16s linear infinite;
    transform-origin: center 60%;
  }

  .hero-sub {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4rem;
    align-items: end;
    border-top: 1px solid var(--rule);
    padding-top: 2rem;
    opacity: 0;
    animation: fadeUp 0.9s 1.05s ease-out forwards;
  }
  .hero-sub p {
    font-family: 'Fraunces', serif;
    font-weight: 350;
    font-size: clamp(1.05rem, 1.5vw, 1.5rem);
    line-height: 1.5;
    max-width: 54ch;
    color: var(--ink-soft);
    font-variation-settings: "opsz" 14, "SOFT" 50;
  }
  .hero-sub p em {
    font-style: italic;
    color: var(--ink);
  }
  .hero-cta {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    text-decoration: none;
    padding: 1rem 1.75rem;
    border: 1px solid var(--ink);
    background: var(--ink);
    color: var(--paper);
    transition: background 0.3s, border-color 0.3s, color 0.3s;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
  }
  .hero-cta:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--paper);
  }
  .hero-cta .arrow { transition: transform 0.3s; }
  .hero-cta:hover .arrow { transform: translateX(5px); }

  /* ─────────── MARQUEE ─────────── */
  .marquee {
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    padding: 1.1rem 0;
    overflow: hidden;
    background: var(--paper-warm);
  }
  .marquee-track {
    display: flex;
    gap: 3rem;
    animation: scroll 55s linear infinite;
    width: max-content;
  }
  .marquee-item {
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-size: 1.05rem;
    color: var(--ink-soft);
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 3rem;
  }
  .marquee-item::after {
    content: '✦';
    color: var(--accent);
    font-style: normal;
    font-size: 0.7em;
  }

  /* ─────────── WORK ─────────── */
  .work {
    padding: clamp(5rem, 12vh, 9rem) 0 clamp(4rem, 8vh, 6rem);
    position: relative;
    overflow: hidden;
  }
  .section-label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--ink-quiet);
    margin-bottom: 2.5rem;
  }
  .section-label::before {
    content: '';
    width: 20px;
    height: 1px;
    background: var(--accent);
    flex-shrink: 0;
  }
  .section-head {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 4rem;
    align-items: end;
    margin-bottom: 5rem;
  }
  .section-head h2 {
    font-family: 'Fraunces', serif;
    font-weight: 400;
    font-size: clamp(2.25rem, 4.5vw, 4rem);
    line-height: 1;
    letter-spacing: -0.025em;
    font-variation-settings: "opsz" 100, "SOFT" 35;
  }
  .section-head h2 em {
    font-style: italic;
    font-weight: 300;
    color: var(--accent);
  }
  .section-head p {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--ink-soft);
    max-width: 44ch;
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 2.5rem 2rem;
  }
  .project {
    grid-column: span 6;
    text-decoration: none;
    color: var(--ink);
    display: block;
    cursor: pointer;
  }
  .project:nth-child(1) { grid-column: span 7; }
  .project:nth-child(2) { grid-column: span 5; }
  .project:nth-child(3) { grid-column: span 5; }
  .project:nth-child(4) { grid-column: span 7; }

  .project-thumb {
    margin-bottom: 1.25rem;
    overflow: hidden;
    position: relative;
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.5s ease;
  }
  .project:hover .project-thumb {
    transform: translateY(-7px);
    box-shadow: 0 18px 48px rgba(19,16,11,0.16);
  }

  /* Real screenshot thumbs — browser preview style */
  .thumb-screen {
    background: #ffffff;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    isolation: isolate;
  }
  .thumb-chrome {
    background: #E8E4DE;
    padding: 0.45rem 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
    border-bottom: 1px solid rgba(0,0,0,0.1);
  }
  .thumb-chrome .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #C8C0B8;
  }
  .thumb-chrome .dot:nth-child(1) { background: #FF6058; }
  .thumb-chrome .dot:nth-child(2) { background: #FFBD2E; }
  .thumb-chrome .dot:nth-child(3) { background: #28CA41; }
  .thumb-chrome .bar {
    flex: 1;
    height: 18px;
    background: rgba(0,0,0,0.08);
    border-radius: 3px;
    margin: 0 0.5rem;
  }
  .thumb-screen-img {
    overflow: hidden;
    position: relative;
    aspect-ratio: 16 / 10;
    background: #ffffff;
  }
  .thumb-screen img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    /* Skip the site nav bar, show the hero content */
    object-position: center 10%;
    transition: transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .project:hover .thumb-screen img {
    transform: scale(1.025);
  }


  .project-meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-top: 1px solid var(--rule);
    padding-top: 1rem;
    margin-bottom: 0.45rem;
  }
  .project-name {
    font-family: 'Fraunces', serif;
    font-size: 1.35rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    transition: color 0.2s;
  }
  .project:hover .project-name { color: var(--accent); }
  .project-year {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    color: var(--ink-quiet);
  }
  .project-desc {
    color: var(--ink-soft);
    font-size: 0.92rem;
    line-height: 1.55;
    max-width: 50ch;
  }
  .project-tags {
    margin-top: 0.75rem;
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .project-tags span {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.67rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-quiet);
  }
  .project-tags span:not(:last-child)::after {
    content: ' / ';
    margin-left: 0.45rem;
  }

  /* ─────────── WHAT I DO ─────────── */
  .what {
    padding: clamp(5rem, 10vh, 8rem) 0;
    border-top: 1px solid var(--rule);
    background: var(--paper-warm);
    position: relative;
    overflow: hidden;
  }
  .what-grid {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 5rem;
    align-items: start;
  }
  .what-grid h2 {
    font-family: 'Fraunces', serif;
    font-weight: 400;
    font-size: clamp(2rem, 3.5vw, 3.25rem);
    line-height: 1.02;
    letter-spacing: -0.025em;
    font-variation-settings: "opsz" 72, "SOFT" 35;
    position: sticky;
    top: 5rem;
  }
  .what-grid h2 em {
    font-style: italic;
    color: var(--accent);
  }
  .what-prose p {
    font-family: 'Fraunces', serif;
    font-weight: 350;
    font-size: clamp(1.05rem, 1.4vw, 1.35rem);
    line-height: 1.6;
    color: var(--ink);
    margin-bottom: 1.75rem;
    font-variation-settings: "opsz" 24, "SOFT" 50;
  }
  .what-prose p:last-child { margin-bottom: 0; color: var(--ink-soft); }
  .what-prose strong {
    font-weight: 500;
    color: var(--ink);
    background: linear-gradient(to top, rgba(200,64,31,0.15) 35%, transparent 35%);
    padding: 0 0.1em;
  }

  /* ─────────── CLIENTS ─────────── */
  .clients {
    padding: clamp(5rem, 10vh, 8rem) 0;
    border-top: 1px solid var(--rule);
    position: relative;
    overflow: hidden;
  }
  .clients-grid {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 6rem;
    align-items: start;
  }
  .clients-sticky {
    position: sticky;
    top: 5rem;
  }
  .clients h2 {
    font-family: 'Fraunces', serif;
    font-weight: 400;
    font-size: clamp(2rem, 3.5vw, 3.25rem);
    line-height: 1.02;
    letter-spacing: -0.025em;
    font-variation-settings: "opsz" 72, "SOFT" 35;
    margin-bottom: 1.5rem;
  }
  .clients h2 em {
    font-style: italic;
    color: var(--accent);
  }
  .clients-aside-head {
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-size: 1rem;
    color: var(--ink-soft);
    line-height: 1.55;
    max-width: 36ch;
  }
  .clients-list { display: grid; gap: 0; }
  .clients-sublabel {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.67rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--ink-quiet);
    padding-bottom: 0.6rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .clients-sublabel::before {
    content: '';
    width: 16px;
    height: 1px;
    background: var(--accent);
    flex-shrink: 0;
  }
  .clients-sublabel.spaced { margin-top: 2.75rem; }
  .clients-aside {
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-size: 0.95rem;
    color: var(--ink-soft);
    line-height: 1.55;
    padding: 0.75rem 0 1rem;
    margin-bottom: 0.25rem;
    border-bottom: 1px solid var(--rule);
    max-width: 52ch;
  }
  .client-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2rem;
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--rule);
    align-items: baseline;
    transition: padding-left 0.25s ease;
  }
  .client-row:hover { padding-left: 0.75rem; }
  .client-row:hover .client-name { color: var(--accent); }
  .client-name {
    font-family: 'Fraunces', serif;
    font-size: 1.45rem;
    font-weight: 400;
    transition: color 0.25s;
  }
  .client-meta {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    color: var(--ink-quiet);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .clients-note {
    margin-top: 2.25rem;
    font-family: 'Fraunces', serif;
    font-style: italic;
