  }

  /* ─────────── CONTACT FORM ─────────── */
  .contact-form-wrap {
    max-width: 620px;
    margin: 0 auto;
    text-align: left;
  }
  .field {
    margin-bottom: 1.5rem;
  }
  .field label {
    display: block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--ink-quiet);
    margin-bottom: 0.55rem;
  }
  .field label .req {
    color: var(--accent);
    margin-left: 0.15em;
  }
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    font-family: 'Geist', -apple-system, sans-serif;
    font-size: 1rem;
    color: var(--ink);
    background: rgba(255, 255, 255, 0.35);
    border: 1px solid var(--rule);
    border-radius: 0;
    padding: 0.85rem 1rem;
    line-height: 1.4;
    transition: border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
    -webkit-appearance: none;
    appearance: none;
  }
  .field select {
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='12' height='8' viewBox='0 0 12 8'><path d='M1 1l5 5 5-5' stroke='%23857A6D' stroke-width='1.4' fill='none' stroke-linecap='round' stroke-linejoin='round'/></svg>");
    background-repeat: no-repeat;
    background-position: right 1rem center;
    padding-right: 2.5rem;
    cursor: pointer;
  }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--ink);
    background: rgba(255, 255, 255, 0.7);
    box-shadow: 0 0 0 3px var(--accent-glow);
  }
  .field textarea {
    min-height: 140px;
    resize: vertical;
    line-height: 1.55;
    font-family: 'Geist', -apple-system, sans-serif;
  }
  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }
  .honey-pot {
    position: absolute;
    left: -10000px;
    top: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .cf-turnstile-wrap {
    margin: 1.5rem 0 1.75rem;
    min-height: 65px;
  }
  .form-actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .form-submit {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 1rem 1.75rem;
    border: 1px solid var(--ink);
    background: var(--ink);
    color: var(--paper);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    transition: background 0.3s ease, border-color 0.3s ease, color 0.3s ease, opacity 0.2s ease;
  }
  .form-submit:hover:not([disabled]) {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--paper);
  }
  .form-submit[disabled] {
    opacity: 0.5;
    cursor: progress;
  }
  .form-submit .arrow { transition: transform 0.3s; }
  .form-submit:hover:not([disabled]) .arrow { transform: translateX(5px); }

  .form-error-inline {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
    margin: 0;
  }

  /* ─────────── FORM SUCCESS STATE ─────────── */
  .form-status {
    text-align: center;
    padding: clamp(2.5rem, 6vw, 4.5rem) 1rem;
