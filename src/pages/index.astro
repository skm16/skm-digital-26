    background: #0C1A18;
    color: var(--paper);
    position: relative;
    overflow: hidden;
  }
  .kisho::before {
    content: '';
    position: absolute;
    top: -160px;
    right: -160px;
    width: 560px;
    height: 560px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(42,157,143,0.18) 0%, transparent 65%);
    pointer-events: none;
  }
  .kisho::after {
    content: '';
    position: absolute;
    bottom: -100px;
    left: -100px;
    width: 360px;
    height: 360px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(42,157,143,0.08) 0%, transparent 65%);
    pointer-events: none;
  }
  .kisho-inner {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 5rem;
    align-items: center;
    position: relative;
    z-index: 1;
  }
  .kisho .k-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: #2A9D8F;
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .kisho .k-label::before {
    content: '';
    width: 16px;
    height: 1px;
    background: #2A9D8F;
  }
  .kisho h2 {
    font-family: 'Fraunces', serif;
    font-weight: 400;
    font-size: clamp(2rem, 3.5vw, 3.25rem);
    line-height: 1.05;
    letter-spacing: -0.025em;
    font-variation-settings: "opsz" 72, "SOFT" 30;
    margin-bottom: 1.5rem;
  }
  .kisho h2 em {
    font-style: italic;
    color: #2A9D8F;
  }
  .kisho p {
    font-size: 1rem;
    line-height: 1.65;
    color: rgba(240,234,224,0.7);
    margin-bottom: 2rem;
    max-width: 48ch;
  }
  .kisho-link {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--paper);
    text-decoration: none;
    border-bottom: 1px solid rgba(42,157,143,0.6);
    padding-bottom: 0.4rem;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    transition: gap 0.3s, border-color 0.3s;
  }
  .kisho-link:hover { gap: 1.1rem; border-color: #2A9D8F; }

  /* Kisho brand typography */
  .kisho-brand {
    font-family: 'Nunito', sans-serif;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: #2A9D8F;
  }

  /* Kisho visual — scrolling screenshot */
  .kisho-visual {
    position: relative;
    border: 1px solid rgba(42,157,143,0.2);
    background: #ffffff;
    overflow: hidden;
    box-shadow: 0 32px 80px rgba(0,0,0,0.5), 0 0 0 1px rgba(42,157,143,0.1);
    display: flex;
    flex-direction: column;
    height: 420px;
    isolation: isolate;
  }
  /* Browser chrome for Kisho */
  .kisho-visual .k-chrome {
    background: #0F1F1D;
    padding: 0.5rem 0.85rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    border-bottom: 1px solid rgba(42,157,143,0.15);
    flex-shrink: 0;
    z-index: 2;
  }
  .kisho-visual .k-chrome .k-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }
  .kisho-visual .k-chrome .k-dot:nth-child(1) { background: #FF6058; }
  .kisho-visual .k-chrome .k-dot:nth-child(2) { background: #FFBD2E; }
  .kisho-visual .k-chrome .k-dot:nth-child(3) { background: #28CA41; }
  .kisho-visual .k-chrome .k-bar {
    flex: 1;
    height: 18px;
    background: rgba(42,157,143,0.12);
    border-radius: 3px;
    margin: 0 0.5rem;
    display: flex;
    align-items: center;
    padding: 0 0.5rem;
    font-family: 'Nunito', sans-serif;
    font-size: 0.6rem;
    font-weight: 600;
    color: rgba(42,157,143,0.5);
    letter-spacing: 0.05em;
  }
  .kisho-visual .k-img-wrap {
    flex: 1;
    overflow: hidden;
    position: relative;
  }
  /* Fade out at bottom */
  .kisho-visual .k-img-wrap::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 80px;
    background: linear-gradient(to bottom, transparent, #0C1A18);
    z-index: 1;
    pointer-events: none;
  }
  .kisho-visual img {
    width: 100%;
    height: auto;
    display: block;
    /* Auto-scroll animation — slowly drifts down */
    animation: kisho-scroll 18s ease-in-out infinite alternate;
  }
  @keyframes kisho-scroll {
    from { transform: translateY(0); }
    to   { transform: translateY(calc(-100% + 390px)); }
  }
  .kisho-visual:hover img {
    animation-play-state: paused;
  }

  /* ─────────── CONTACT ─────────── */
  .contact {
    padding: clamp(6rem, 14vh, 10rem) 0 clamp(4rem, 8vh, 6rem);
    text-align: center;
    position: relative;
  }
  .contact::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 1px;
    height: 5rem;
    background: linear-gradient(to bottom, transparent, var(--rule));
  }
  .contact h2 {
    font-family: 'Fraunces', serif;
    font-weight: 300;
    font-size: clamp(2.5rem, 7vw, 6.5rem);
    line-height: 1;
