  .form-fallback strong {
    font-style: normal;
    color: var(--ink-soft);
    font-family: 'Geist', -apple-system, sans-serif;
    font-weight: 500;
  }

  /* ─────────── FOOTER ─────────── */
  footer {
    border-top: 1px solid var(--rule);
