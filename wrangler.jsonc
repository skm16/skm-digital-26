{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skm-digital-26",
  "main": "dist/_worker.js/index.js",
  "compatibility_date": "2026-05-02",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
  // Non-sensitive runtime config. Wrangler treats this file as the source of
  // truth and will REMOVE any plaintext vars set in the dashboard but not
  // declared here on every deploy. Secrets (RESEND_API_KEY,
  // TURNSTILE_SECRET_KEY) are stored separately and preserved automatically.
  "vars": {
    "CONTACT_FROM_EMAIL": "SKM.digital <sean@skm.digital>",
    "CONTACT_TO_EMAIL": "sean@skm.digital"
  }
}
